{
  "name": "hfbk-course-planner",
  "version": "1.0.0",
  "description": "A private, browser-based bilingual course planner.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck"
  },
  "devDependencies": {
    "eslint": "10.12.0",
    "prettier": "3.9.9",
    "sass": "1.105.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3"
  }
}
